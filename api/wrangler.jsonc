{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "serif-health",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-19",
	"assets": {
		// Built React app. `make deploy` builds it before deploying.
		"directory": "../ui/dist",
		"not_found_handling": "single-page-application",
		// Run the Worker for /api/*; everything else is served as a static asset.
		"run_worker_first": ["/api/*"]
	},
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "serif-health",
			"database_id": "09fc014c-adc2-48c1-8ae9-62ea3bd9f2c5",
			"migrations_dir": "migrations"
		}
	]
}
