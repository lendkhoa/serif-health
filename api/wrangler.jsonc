{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "serif-health",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-19",
	"assets": {
		// Built React app. `make deploy` builds it before deploying.
		"directory": "../ui/dist",
		"not_found_handling": "single-page-application",
		// Run the Worker for /api/*; everything else is served as a static asset.
		"run_worker_first": ["/api/*"]
	},
	"observability": { "enabled": true },
	"vars": { "OLLAMA_MODEL": "gemma3:4b" },
	// Ollama on a private machine, through a Cloudflare Tunnel.
	"vpc_services": [
		{
			"binding": "VPC_SERVICE",
			"service_id": "01a20df6-061c-7f80-9e92-b4847ab956d9",
			"remote": true
		}
	],
	// Workers AI: used when Ollama does not answer.
	"ai": { "binding": "AI" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "serif-health",
			"database_id": "09fc014c-adc2-48c1-8ae9-62ea3bd9f2c5",
			"migrations_dir": "migrations"
		}
	]
}
